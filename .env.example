# ──────────────────────────────────────────────────────────────────────────
# polybot environment configuration (example)
#
# Copy to `.env` and fill in. On the CURRENT stage (read-only + paper-trading)
# NO private key is required — we never place real orders. The wallet-related
# variables below are placeholders for a FUTURE live-trading stage only.
# ──────────────────────────────────────────────────────────────────────────

# Path to the SQLite database file used for collected data.
POLYBOT_DB_PATH=data/polybot.db

# Path to the YAML config file (see config/config.example.yaml).
POLYBOT_CONFIG=config/config.example.yaml

# Logging level: DEBUG | INFO | WARNING | ERROR
POLYBOT_LOG_LEVEL=INFO

# ── FUTURE live-trading only — leave empty for read-only/paper stage ──
# Never commit a real private key. Use a dedicated, low-balance wallet.
# POLYBOT_PRIVATE_KEY=
# POLYBOT_FUNDER_ADDRESS=
